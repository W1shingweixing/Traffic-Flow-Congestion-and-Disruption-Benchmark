# 2. Get the accident sample
sample = samples[25173]


factual_y = sample['factual_traffic']      
counterfactual_y = sample['counterfactual_traffic']  # No accidents / same period last week
time_steps = range(len(factual_y))            # 48 

# 4. figure
plt.figure(figsize=(10, 5), dpi=100)

# Counterfactual
plt.plot(time_steps, counterfactual_y, label='Counterfactual (No Incident - Last Week)', color='green', linestyle='--', linewidth=2)

# Factual
plt.plot(time_steps, factual_y, label='Factual (With Incident)', color='red', linewidth=2)

plt.axvline(x=12, color='gray', linestyle=':', label='Incident Occur Time')

plt.title(f"Counterfactual Impact Estimation (Station: {sample['station_id']})")
plt.xlabel("Time Steps (5 min intervals)")
plt.ylabel("Traffic Volume")
plt.legend()
plt.grid(True, alpha=0.3)

# Figure display
plt.show()